# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret
FLASK_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=market_intelligence
DB_USER=root
DB_PASSWORD=your_mysql_password

# Groq AI Agent
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Discovery Search
# DuckDuckGo tidak membutuhkan API key untuk discovery dasar.
SEARCH_PROVIDER=duckduckgo
DUCKDUCKGO_VERIFY_SSL=false
BING_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Upload
MAX_UPLOAD_MB=20
